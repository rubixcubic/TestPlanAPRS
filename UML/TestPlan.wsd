@startuml

' Define Classes
class RoboticSystem {
    robotic_system_id: String
    name: String
    purpose: String
}

class Robot {
    robot_id: String
    name: String
    model: String
    manufacturer: String
}

class MechanicalStructure {
    name: String
    type: String
    material: String
}

class Dimension {
    length: Float
    width: Float
    height: Float
}

class Sensor {
    name: String
    type: String
    range: Float
    resolution: String
}

class Actuator {
    name: String
    actuator_type: String
    power_rating: Float
    speed: Float
}

class ControlSystem {
    name: String
    processor_type: String
    operating_system: String
    memory: Integer
}

class Software {
    name: String
    version: String
    function: String
}

class PowerSupply {
    name: String
    power_type: String
    capacity: Float
    voltage: Float
}

class CommunicationSystem {
    name: String
    communication_type: String
    bandwidth: Float
}

class HumanMachineInterface {
    name: String
    interface_type: String
}

class DataStorage {
    name: String
    storage_type: String
}

class ExternalSoftware {
    name: String
    version: String
    function: String
}

class ControlInterface {
    name: String
    type: String
}

class EnvironmentalModel {
    name: String
    description: String
}

' Define the abstract class AgilityAspect
class AgilityAspect {
    agility_aspect_id: String
    name: String
    description: String
    concepts: Collection<Concept>
}

class Attribute {
    attribute_id: String
    name: String
    example: String
    description: String
    metric: Metric
}

class Concept {
    concept_id: String
    name: String
    description: String
    attributes: Collection<Attribute>
}

class Metric {
    metric_id: String
    description: String
    formula: String
    formula_use: String
}

' Define TestPlan class
class TestPlan {
    test_plan_id: String
    agility_aspects: Collection<AgilityAspect>
    robotic_systems: Collection<RoboticSystem>
    name: String
    objective: String
    description: String
    repetition_number: Integer
}

class Measurement {
    measurement_id: String
    value: Float
    timestamp: DateTime
    notes: String
    human_involvement: Bool
    human_involvement_description: String
    test_plan: TestPlan
}

' class Experiment {
'     name: String
'     date: Date
'     description: String
' }

AgilityAspect "1" o-- "1..*" Concept : has >
Concept "1..*" o-- "1..*" Attribute : has >
Attribute "1..*" o-- "1" Metric : has >
AgilityAspect "1..*" --> "1..*" TestPlan : is_assessed_by
TestPlan "1" --> "1" Measurement : generates
RoboticSystem "1..*" --> "1..*" TestPlan : is_required_by
' TestPlan "1..*" --> "1..*" RoboticSystem : requires
' Define subclasses of AgilityAspect
' class PlanningAspect
' class SoftwareReconfigurabilityAspect
' class HardwareReconfigurabilityAspect
' class SensingAspect
' class PerceptionAspect
' class ExecutionAspect
' class TaskingAspect
' class TaskRepresentationAspect
' class ReasoningAspect
' class CommunicationsAspect

' Establish inheritance relationships
' AgilityAspect <|-- PlanningAspect
' AgilityAspect <|-- SoftwareReconfigurabilityAspect
' AgilityAspect <|-- HardwareReconfigurabilityAspect
' AgilityAspect <|-- SensingAspect
' AgilityAspect <|-- PerceptionAspect
' AgilityAspect <|-- ExecutionAspect
' AgilityAspect <|-- TaskingAspect
' AgilityAspect <|-- TaskRepresentationAspect
' AgilityAspect <|-- ReasoningAspect
' AgilityAspect <|-- CommunicationsAspect







' ' Define Relationships

' ' Composition: RoboticSystem consists of one or more Robots
RoboticSystem "1" *-- "1..*" Robot : consists_of >

' ' Composition: Robot has a MechanicalStructure
Robot "1" *-- "1" MechanicalStructure : consists_of >

' ' Composition: MechanicalStructure has Dimensions
MechanicalStructure "1" *-- "1" Dimension : has >

' ' Composition: Robot has a ControlSystem
Robot "1" *-- "1" ControlSystem : has >

' ' Composition: Robot has Actuators
Robot "1" *-- "1..*" Actuator : has >

' ' Aggregation: Robot has Sensors
Robot "0..1" o-- "0..*" Sensor : has >

' ' Aggregation: Robot has PowerSupply
Robot "1" o-- "1..*" PowerSupply : has >

' ' Association: Robot runs Software
Robot "1" --> "1..*" Software : runs_software

' ' Aggregation: Robot has CommunicationSystems
Robot "1" o-- "0..*" CommunicationSystem : has

' ' Aggregation: Robot has HumanMachineInterfaces
Robot "1" o-- "0..*" HumanMachineInterface : has >

' ' Aggregation: Robot has DataStorage
Robot "1" o-- "0..*" DataStorage : has >

' ' Aggregation: RoboticSystem uses ExternalSoftware
RoboticSystem "1" o-- "0..*" ExternalSoftware : has >

' ' Aggregation: RoboticSystem has ControlInterfaces
RoboticSystem "1" o-- "0..*" ControlInterface : has >

' ' Aggregation: RoboticSystem uses EnvironmentalModels
RoboticSystem "1" o-- "0..*" EnvironmentalModel : has >


@enduml
